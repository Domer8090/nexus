# Nexus local configuration. Nothing here is a secret, and none of it is required.
# Agents never use API keys: each one signs in with its own official flow.

# Where Nexus keeps its SQLite database and agent worktrees. Default: ~/.nexus
# NEXUS_HOME=

# Optional: Backboard (backboard.io) explains a change in plain words when you press Explain and
# pick Backboard. Put a real key only in .env.local, which git ignores. Agents never receive it.
# BACKBOARD_API_KEY=
# BACKBOARD_MODEL=provider/model
